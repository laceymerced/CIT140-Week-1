<mxfile host="app.diagrams.net" pages="4">
  <diagram id="w09-0" name="01 Choice">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=0;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" value="CIT 140 Week 9 — 01 Choice" vertex="1">
          <mxGeometry height="50" width="1000" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" value="Problem:&#xa;Archive requests can be handed off before the destination and reference information are confirmed. Missing or incorrect information can cause delays and requests to be sent back for clarification.&#xa;&#xa;Boundary:&#xa;This design covers the request from the service desk through delivery to the correct keeper or return to the requester for clarification. Retrieving archive contents, payments and replacing archive equipment are outside the design.&#xa;&#xa;Approach A – Improve the existing register:&#xa;Keep the spreadsheet and paper process but add required fields, clearer status rules, staff checks and delivery confirmation. This would be easier for staff because they already know the current system but it would still depend on manual checks and handoffs.&#xa;&#xa;Approach B – Small request interface:&#xa;Create a simple request interface with required fields, status tracking, correction steps and role based information. This could prevent missing information earlier and make the request easier to track but it would require training and implementation.&#xa;&#xa;Choice:&#xa;I choose Approach B which is the small request interface because it gives clearer checks before a request is handed off and makes missing information easier to correct.&#xa;&#xa;Tradeoff:&#xa;The main tradeoff is that the new interface would require training and setup even though Approach A would be easier to continue using right away." vertex="1">
          <mxGeometry height="130" width="1000" x="40" y="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
